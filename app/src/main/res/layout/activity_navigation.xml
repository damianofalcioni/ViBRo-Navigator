<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/gpsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text=""
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/turnInstructionRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nextDirectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/nav_no_route"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/afterNextDirectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:gravity="center_horizontal">

        <vibro.navigator.nav.compass.ui.NavigationCompassView
            android:id="@+id/navigationCompassView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/destinationText"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp" />

        <ImageButton
            android:id="@+id/exportRouteButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignBottom="@id/navigationCompassView"
            android:layout_alignEnd="@id/navigationCompassView"
            android:contentDescription="@string/action_export_route"
            android:src="@drawable/ic_export"
            android:tint="@null" />

        <TextView
            android:id="@+id/speedLimitText"
            style="@style/Widget.ViBRoNavigator.SpeedLimitBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignTop="@id/navigationCompassView"
            android:layout_alignStart="@id/navigationCompassView"
            android:maxLines="1"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/navigationSettingsButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignBottom="@id/navigationCompassView"
            android:layout_alignStart="@id/navigationCompassView"
            android:contentDescription="@string/action_open_settings"
            android:src="@drawable/ic_settings"
            android:tint="@null" />

        <TextView
            android:id="@+id/destinationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:text=""
            android:textAlignment="center"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/blockedRoadButton"
            style="@style/Widget.ViBRoNavigator.IconButton.Circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/action_blocked_road"
            android:padding="8dp"
            android:src="@drawable/ic_blocked_road"
            android:tint="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/stopNavButton"
            style="@style/Widget.ViBRoNavigator.IconButton.Circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/action_stop_navigation"
            android:src="@drawable/ic_stop"
            android:tint="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/pauseResumeNavButton"
            style="@style/Widget.ViBRoNavigator.IconButton.Circle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/action_pause_navigation"
            android:src="@drawable/ic_pause"
            android:tint="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
