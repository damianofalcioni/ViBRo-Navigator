<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/aboutButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            style="@style/Widget.VibeNavigator.IconButton"
            android:contentDescription="@string/action_about"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_in_app" />
    </LinearLayout>

    <TextView
        android:id="@+id/gpsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/nextDirectionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/nav_no_route"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/afterNextDirectionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/remainingText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/nav_no_route"
        android:textColor="@color/white"
        android:textSize="24sp" />

    <Button
        android:id="@+id/blockedRoadButton"
        style="@style/Widget.VibeNavigator.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_blocked_road" />

    <Button
        android:id="@+id/stopNavButton"
        style="@style/Widget.VibeNavigator.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/action_stop_navigation" />

</LinearLayout>
