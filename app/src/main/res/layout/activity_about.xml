<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/aboutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_short_description"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/aboutLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aboutSourceCodeLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_source_code_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/aboutReportIssueLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_bug"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_report_issue_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/aboutPrivacyPolicyLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_info"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_privacy_policy_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/aboutTermsOfServiceLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_list"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_terms_of_service_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_legal"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:text="@string/about_credits"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <ViewStub
            android:id="@+id/aboutSettingsStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@+id/aboutSettingsSection"
            android:layout="@layout/about_settings_section" />

        <ViewStub
            android:id="@+id/aboutDiagnosticsStub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inflatedId="@+id/aboutDiagnosticsSection"
            android:layout="@layout/about_diagnostics_section" />
    </LinearLayout>
</ScrollView>
