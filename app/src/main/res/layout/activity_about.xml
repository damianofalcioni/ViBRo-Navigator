<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/aboutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aboutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_short_description"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/aboutLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aboutSourceCodeLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_source_code_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/aboutReportIssueLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:drawableStart="@drawable/ic_bug"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:text="@string/about_report_issue_link"
                android:textColor="?android:attr/textColorLink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/aboutLegal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_legal"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:text="@string/about_credits"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/vibroOutlineColor" />

        <TextView
            android:id="@+id/aboutSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/about_settings_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/aboutLogEnabledSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/label_log_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/aboutFusedLocationSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/label_fused_location_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/aboutImperialUnitsSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/label_imperial_units_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/aboutLightThemeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/label_light_theme_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/aboutAndroidAutoSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/label_android_auto_integration_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/aboutPoiCategoriesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/aboutPoiCategoriesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_poi_categories"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/aboutPoiCategoriesButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/action_edit_poi_categories"
                android:src="@drawable/ic_list" />

            <Switch
                android:id="@+id/aboutPoiCategoriesSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutManeuverVoiceRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/aboutManeuverVoiceLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_maneuver_voice"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/aboutManeuverVoiceSettingsButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/action_open_speech_directions_settings"
                android:src="@drawable/ic_settings" />

            <Switch
                android:id="@+id/aboutManeuverVoiceSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:showText="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutGooglePoiApiKeyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/aboutGooglePoiApiKeyLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_google_poi_api_key"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/aboutGooglePoiApiKeyButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/action_edit_google_poi_api_key"
                android:src="@drawable/ic_password" />

            <Switch
                android:id="@+id/aboutGooglePoiSearchSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_enable_google_poi_search"
                android:minHeight="48dp"
                android:showText="false" />
        </LinearLayout>

        <Button
            android:id="@+id/aboutExportDatabaseButton"
            style="@style/Widget.ViBRoNavigator.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_export"
            android:drawablePadding="8dp"
            android:text="@string/action_export_database" />

        <Button
            android:id="@+id/aboutImportDatabaseButton"
            style="@style/Widget.ViBRoNavigator.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_import"
            android:drawablePadding="8dp"
            android:text="@string/action_import_database" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="?attr/vibroOutlineColor" />

        <TextView
            android:id="@+id/aboutSensorStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/about_diagnostic_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/aboutPermissionStatusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_permission_status_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/aboutPermissionStatusList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/aboutPermissionLocationRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/aboutPermissionLocationMark"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_permission_status_ok"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/aboutPermissionLocationLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_permission_location"
                    android:textColor="?attr/vibroTextPrimaryColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/aboutPermissionLocationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/permission_status_ok"
                    android:textColor="@color/success"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aboutPermissionLocationServicesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/aboutPermissionLocationServicesMark"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_permission_status_ok"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/aboutPermissionLocationServicesLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_permission_location_services"
                    android:textColor="?attr/vibroTextPrimaryColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/aboutPermissionLocationServicesStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/permission_status_ok"
                    android:textColor="@color/success"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aboutPermissionNotificationsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/aboutPermissionNotificationsMark"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_permission_status_ok"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/aboutPermissionNotificationsLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_permission_notifications"
                    android:textColor="?attr/vibroTextPrimaryColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/aboutPermissionNotificationsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/permission_status_ok"
                    android:textColor="@color/success"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aboutPermissionBatteryRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/aboutPermissionBatteryMark"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_permission_status_ok"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/aboutPermissionBatteryLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_permission_battery"
                    android:textColor="?attr/vibroTextPrimaryColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/aboutPermissionBatteryStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/permission_status_ok"
                    android:textColor="@color/success"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/aboutSensorStatusSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/about_sensor_status_title"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/aboutSensorStatusBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/vibroTextSecondaryColor"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/aboutSymbolTestTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_direction_notification_tests"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/aboutSymbolTestButtonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/aboutSymbolTestLeftButton"
                style="@style/Widget.ViBRoNavigator.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_test_left_notification"
                android:textSize="14sp" />

            <Button
                android:id="@+id/aboutSymbolTestOtherButton"
                style="@style/Widget.ViBRoNavigator.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_test_other_notification"
                android:textSize="14sp" />

            <Button
                android:id="@+id/aboutSymbolTestRightButton"
                style="@style/Widget.ViBRoNavigator.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/action_test_right_notification"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
