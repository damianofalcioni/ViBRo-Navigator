<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

        <ImageButton
            android:id="@+id/aboutButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:contentDescription="@string/action_about"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo_in_app" />
        </LinearLayout>

        <Spinner
            android:id="@+id/routeModeSpinner"
            style="@style/Widget.ViBRoNavigator.Spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:spinnerMode="dropdown" />

        <TextView
            android:id="@+id/profileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_vehicle_profile"
            android:textColor="?attr/vibroTextPrimaryColor" />

        <LinearLayout
            android:id="@+id/profileSelectionPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <vibro.navigator.main.RepeatSelectSpinner
                android:id="@+id/profileSpinner"
                style="@style/Widget.ViBRoNavigator.Spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:spinnerMode="dropdown" />

            <ImageButton
                android:id="@+id/profileSettingsButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_profile_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/destinationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_destination"
            android:textColor="?attr/vibroTextPrimaryColor" />

        <FrameLayout
            android:id="@+id/routeSetupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <vibro.navigator.main.MainRouteRailView
                android:id="@+id/routeRailView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/routeSetupContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/destinationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="18dp">

                    <EditText
                        android:id="@+id/destinationEdit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_search_destination"
                        android:importantForAutofill="no"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:textColor="?attr/vibroTextPrimaryColor"
                        android:textColorHint="?attr/vibroTextHintColor" />

                    <ImageButton
                        android:id="@+id/destinationMapButton"
                        style="@style/Widget.ViBRoNavigator.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/action_open_map"
                        android:src="@drawable/ic_map_picker" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stopsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/saveRouteButton"
                        style="@style/Widget.ViBRoNavigator.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/action_save_route"
                        android:src="@drawable/ic_route_save" />

                    <Button
                        android:id="@+id/addStopButton"
                        style="@style/Widget.ViBRoNavigator.Button.Fab"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/action_add_stop"
                        android:text="@string/symbol_plus" />

                    <ImageButton
                        android:id="@+id/restoreRouteButton"
                        style="@style/Widget.ViBRoNavigator.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/action_restore_route"
                        android:src="@drawable/ic_route_restore" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/startNavButton"
                        style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                        android:layout_width="132dp"
                        android:layout_height="132dp"
                        android:contentDescription="@string/action_start_navigation"
                        android:padding="30dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        android:tint="@null" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/roundTripSetupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/roundTripDistanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/vibroTextPrimaryColor" />

            <EditText
                android:id="@+id/roundTripDistanceEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textColorHint="?attr/vibroTextHintColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/roundTripStartNavButton"
                    style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:contentDescription="@string/action_start_navigation"
                    android:padding="30dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    android:tint="@null" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
