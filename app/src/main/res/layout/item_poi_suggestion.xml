<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/vibroSurfaceStrongColor"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/suggestionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/poiSuggestionInfoButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_poi_details"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_info"
        android:tint="?attr/vibroIconColor"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/editSuggestionButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_edit"
        android:src="@drawable/ic_edit"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/deleteSuggestionButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete"
        android:visibility="gone" />
</LinearLayout>
