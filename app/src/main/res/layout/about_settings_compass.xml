<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:id="@+id/aboutSettingsCompassTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/about_settings_category_compass"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/aboutCompassSurroundingStreetsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aboutCompassSurroundingStreetsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_compass_surrounding_streets_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassSurroundingStreetsSettingsButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_configure_surrounding_street_types"
            android:src="@drawable/ic_settings" />

        <Switch
            android:id="@+id/aboutCompassSurroundingStreetsSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/label_compass_surrounding_streets_enabled"
            android:minHeight="48dp"
            android:showText="false" />

        <ImageButton
            android:id="@+id/aboutCompassSurroundingStreetsInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassInstantZoomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassInstantZoomSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_instant_zoom_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassInstantZoomInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassStationaryFullRouteZoomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassStationaryFullRouteZoomSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_stationary_full_route_zoom_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassStationaryFullRouteZoomInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassFullscreenRouteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassFullscreenRouteSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_fullscreen_route_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassFullscreenRouteInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassCentralPerspectiveRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassCentralPerspectiveSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_central_perspective_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassCentralPerspectiveInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassDistanceCirclesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassDistanceCirclesSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_distance_circles_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassDistanceCirclesInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutShowHintPanelRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutShowHintPanelSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_show_hint_panel"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutShowHintPanelInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>
</merge>
