<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ViBRoNavigator.GestureHintSection">
    <TextView
        android:id="@+id/gestureMapControlsHeading"
        style="@style/Widget.ViBRoNavigator.GestureHintTitle"
        android:layout_marginBottom="4dp"
        android:text="@string/nav_gesture_map_controls_title" />
    <LinearLayout
        style="@style/Widget.ViBRoNavigator.GestureHintRow">
        <ImageView
            style="@style/Widget.ViBRoNavigator.GestureHintIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_gesture_views" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.ViBRoNavigator.GestureHintBody"
                android:text="@string/nav_gesture_views_body" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        style="@style/Widget.ViBRoNavigator.GestureHintRow">
        <ImageView
            style="@style/Widget.ViBRoNavigator.GestureHintIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_gesture_zoom" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.ViBRoNavigator.GestureHintBody"
                android:text="@string/nav_gesture_zoom_body" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        style="@style/Widget.ViBRoNavigator.GestureHintRow">
        <ImageView
            style="@style/Widget.ViBRoNavigator.GestureHintIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_gesture_tilt" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/Widget.ViBRoNavigator.GestureHintBody"
                android:text="@string/nav_gesture_tilt_body" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
