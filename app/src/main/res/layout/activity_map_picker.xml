<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_margin="16dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/mapUseSelectionButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_use_selected_point"
            android:src="@drawable/ic_map_confirm" />

        <ImageButton
            android:id="@+id/mapCancelButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/action_cancel"
            android:src="@drawable/ic_close" />

        <ImageButton
            android:id="@+id/mapCurrentLocationButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/action_current_location"
            android:src="@drawable/ic_current_location" />

        <LinearLayout
            android:id="@+id/mapPoiControlContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/mapPoiButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/action_map_poi_categories"
                android:src="@drawable/ic_poi_categories" />

            <ImageButton
                android:id="@+id/mapOpenPositionButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/action_open_map_position"
                android:src="@drawable/ic_export" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mapZoomInButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/action_zoom_in"
            android:src="@drawable/ic_plus" />

        <ImageButton
            android:id="@+id/mapZoomOutButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/action_zoom_out"
            android:src="@drawable/ic_minus" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mapPoiPanel"
        android:layout_width="220dp"
        android:layout_height="260dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="68dp"
        android:background="@drawable/bg_map_poi_panel"
        android:fillViewport="false"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/mapPoiCategoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/mapPoiStatus"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_map_poi_panel"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="12sp"
        android:visibility="gone" />
</merge>
