<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/simulationSpeedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/simulationSpeed"
            android:text="@string/simulation_speed_kmh"
            android:textColor="?attr/vibroTextPrimaryColor" />

        <EditText
            android:id="@+id/simulationSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:textColor="?attr/vibroTextPrimaryColor" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/simulationPosition"
            android:text="@string/simulation_initial_position"
            android:textColor="?attr/vibroTextPrimaryColor" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/simulationPosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:hint="@string/simulation_position_hint"
                android:inputType="textNoSuggestions"
                android:singleLine="true"
            android:importantForAutofill="no"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textColorHint="?attr/vibroTextSecondaryColor" />

            <ImageButton
                android:id="@+id/simulationMapButton"
                style="@style/Widget.ViBRoNavigator.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/action_open_map"
                android:src="@drawable/ic_map_picker" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/simulation_config_help"
            android:textColor="?attr/vibroTextSecondaryColor" />
    </LinearLayout>
</ScrollView>
