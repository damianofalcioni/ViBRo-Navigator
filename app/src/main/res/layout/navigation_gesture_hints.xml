<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigationGestureHints"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="12dp"
    android:background="@drawable/bg_navigation_gesture_hints"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        style="@style/Widget.ViBRoNavigator.GestureHintSections"
        android:id="@+id/navigationGestureHintSections">
        <include layout="@layout/navigation_gesture_tips" />
        <include layout="@layout/navigation_street_legend" />
    </LinearLayout>

    <TextView
        android:id="@+id/dismissGestureHints"
        style="@style/Widget.ViBRoNavigator.GestureHintBody"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/nav_gesture_dismiss" />

    <TextView
        android:id="@+id/dontShowGestureHintsAgain"
        style="@style/Widget.ViBRoNavigator.GestureHintTitle"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/nav_gesture_dont_show_again" />
</LinearLayout>
