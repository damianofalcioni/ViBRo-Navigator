<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aboutSettingsSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="?attr/vibroOutlineColor" />

    <TextView
        android:id="@+id/aboutSettingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/about_settings_title"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/aboutSettingsDisplayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/about_settings_category_display"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/aboutLightThemeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutLightThemeSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_light_theme_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutLightThemeInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutImperialUnitsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutImperialUnitsSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_imperial_units_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutImperialUnitsInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/vibroOutlineColor" />

    <TextView
        android:id="@+id/aboutSettingsGuidanceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/about_settings_category_guidance"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/aboutNavigationNotificationsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutNavigationNotificationsSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_navigation_notifications_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutNavigationNotificationsInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutManeuverVoiceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aboutManeuverVoiceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_maneuver_voice"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutManeuverVoiceSettingsButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_open_speech_directions_settings"
            android:src="@drawable/ic_settings" />

        <Switch
            android:id="@+id/aboutManeuverVoiceSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:showText="false" />

        <ImageButton
            android:id="@+id/aboutManeuverVoiceInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutDynamicGpsFixIntervalRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutDynamicGpsFixIntervalSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_dynamic_gps_fix_interval_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutDynamicGpsFixIntervalInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutSingleInstructionModeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutSingleInstructionModeSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_single_instruction_mode_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutSingleInstructionModeInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutNavigationCustomButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aboutNavigationCustomButtonLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_navigation_custom_button"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutNavigationCustomButtonSettingsButton"
