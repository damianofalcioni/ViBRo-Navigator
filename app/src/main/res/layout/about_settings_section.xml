        <ImageButton
            android:id="@+id/aboutLogEnabledInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutExportDatabaseRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/aboutExportDatabaseButton"
            style="@style/Widget.ViBRoNavigator.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_export"
            android:drawablePadding="8dp"
            android:text="@string/action_export_database" />

        <ImageButton
            android:id="@+id/aboutExportDatabaseInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
