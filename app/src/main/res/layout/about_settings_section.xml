        <Switch
            android:id="@+id/aboutNavigationCustomButtonSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/label_navigation_custom_button"
            android:minHeight="48dp"
            android:showText="false" />

        <ImageButton
            android:id="@+id/aboutNavigationCustomButtonInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutAutoSaveGpxRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutAutoSaveGpxSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_auto_save_gpx_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutAutoSaveGpxInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
