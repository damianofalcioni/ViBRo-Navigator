            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutSpeechRecognitionSettingsButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/action_open_speech_recognition_settings"
            android:src="@drawable/ic_settings" />

        <Switch
            android:id="@+id/aboutSpeechRecognitionSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/action_enable_speech_recognition"
