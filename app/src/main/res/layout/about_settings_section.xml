            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aboutCompassFullscreenRouteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <Switch
            android:id="@+id/aboutCompassFullscreenRouteSwitch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/label_compass_fullscreen_route_enabled"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/aboutCompassFullscreenRouteInfoButton"
            style="@style/Widget.ViBRoNavigator.InfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/action_setting_info" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="?attr/vibroOutlineColor" />

    <TextView
        android:id="@+id/aboutSettingsSearchInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/about_settings_category_search_input"
        android:textColor="?attr/vibroTextPrimaryColor"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/aboutPoiCategoriesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aboutPoiCategoriesLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_poi_categories"
