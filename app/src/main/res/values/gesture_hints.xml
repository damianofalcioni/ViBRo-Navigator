<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="navigationGestureHintsOverlay" type="id" />
    <style name="Widget.ViBRoNavigator.GestureHintSections" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintSection" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintLegendRow" parent="Widget.ViBRoNavigator.GestureHintRow">
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintRow" parent="">
        <item name="android:baselineAligned">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintIcon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintTitle" parent="">
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/vibroTextPrimaryColor</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintBody" parent="">
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/vibroTextPrimaryColor</item>
        <item name="android:alpha">0.75</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Widget.ViBRoNavigator.GestureHintStreetSwatch" parent="">
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">@string/street_color_swatch</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
