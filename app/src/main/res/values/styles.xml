<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.VibeNavigator.Button" parent="@android:style/Widget.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.VibeNavigator.Button.Primary" parent="@style/Widget.VibeNavigator.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.VibeNavigator.Button.Secondary" parent="@style/Widget.VibeNavigator.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.VibeNavigator.Button.Danger" parent="@style/Widget.VibeNavigator.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Widget.VibeNavigator.Button.Fab" parent="@style/Widget.VibeNavigator.Button">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@drawable/bg_button_icon</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Widget.VibeNavigator.IconButton" parent="@android:style/Widget.ImageButton">
        <item name="android:background">@drawable/bg_button_icon</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
