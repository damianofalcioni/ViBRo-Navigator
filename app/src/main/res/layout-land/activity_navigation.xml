<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:keepScreenOn="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gpsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:maxLines="1"
            android:text=""
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/turnInstructionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/gpsStatusText"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextDirectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_no_route"
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/afterNextDirectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="?attr/vibroTextPrimaryColor"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/destinationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/navigationActionRow"
            android:layout_below="@id/turnInstructionRow"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text=""
            android:textAlignment="center"
            android:textColor="?attr/vibroTextPrimaryColor"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/navigationActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/blockedRoadButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_blocked_road"
                android:padding="8dp"
                android:src="@drawable/ic_blocked_road"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/stopNavButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_stop_navigation"
                android:src="@drawable/ic_stop"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/pauseResumeNavButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_pause_navigation"
                android:src="@drawable/ic_pause"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <vibro.navigator.nav.compass.ui.NavigationCompassView
            android:id="@+id/navigationFullscreenCompassView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:visibility="gone"
            app:vibroFullscreenRouteMode="true" />

        <vibro.navigator.nav.compass.ui.NavigationCompassView
            android:id="@+id/navigationCompassView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <ImageButton
            android:id="@+id/exportRouteButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignBottom="@id/navigationCompassView"
            android:layout_alignEnd="@id/navigationCompassView"
            android:contentDescription="@string/action_export_route"
            android:src="@drawable/ic_export"
            android:tint="@null" />

        <ImageButton
            android:id="@+id/navigationCustomButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignTop="@id/navigationCompassView"
            android:layout_alignEnd="@id/navigationCompassView"
            android:contentDescription="@string/label_navigation_custom_button"
            android:src="@drawable/ic_custom_dynamic_gps_interval_enabled"
            android:tint="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/speedLimitText"
            style="@style/Widget.ViBRoNavigator.SpeedLimitBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignStart="@id/navigationCompassView"
            android:layout_alignTop="@id/navigationCompassView"
            android:maxLines="1"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/navigationSettingsButton"
            style="@style/Widget.ViBRoNavigator.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignBottom="@id/navigationCompassView"
            android:layout_alignStart="@id/navigationCompassView"
            android:contentDescription="@string/action_open_settings"
            android:src="@drawable/ic_settings"
            android:tint="@null" />
    </RelativeLayout>
</LinearLayout>
