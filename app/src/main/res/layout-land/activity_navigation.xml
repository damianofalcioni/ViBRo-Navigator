<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gpsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/nextDirectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/gpsStatusText"
            android:layout_marginTop="18dp"
            android:text="@string/nav_no_route"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/afterNextDirectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/nextDirectionText"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/destinationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/afterNextDirectionText"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/stopProgressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/destinationText"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="18sp" />

        <Button
            android:id="@+id/blockedRoadButton"
            style="@style/Widget.VibeNavigator.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/stopNavButton"
            android:layout_marginBottom="12dp"
            android:text="@string/action_blocked_road" />

        <Button
            android:id="@+id/stopNavButton"
            style="@style/Widget.VibeNavigator.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="@string/action_stop_navigation" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foregroundGravity="center">

        <com.vibenavigator.NavigationCompassView
            android:id="@+id/navigationCompassView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
