<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:keepScreenOn="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/gpsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/turnInstructionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/gpsStatusText"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextDirectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_no_route"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/afterNextDirectionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/destinationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/turnInstructionRow"
            android:layout_marginTop="16dp"
            android:layout_above="@id/navigationActionRow"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/navigationActionRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/blockedRoadButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_blocked_road"
                android:padding="8dp"
                android:src="@drawable/ic_blocked_road"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/stopNavButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_stop_navigation"
                android:src="@drawable/ic_stop"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/pauseResumeNavButton"
                style="@style/Widget.ViBRoNavigator.IconButton.Circle"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/action_pause_navigation"
                android:src="@drawable/ic_pause"
                android:tint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foregroundGravity="center">

        <vibro.navigator.nav.compass.ui.NavigationCompassView
            android:id="@+id/navigationCompassView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

</LinearLayout>
