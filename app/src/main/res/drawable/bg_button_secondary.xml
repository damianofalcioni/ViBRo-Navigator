<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/vibroRippleColor">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="?attr/vibroIconColor" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="?attr/vibroSurfaceColor" />
            <stroke
                android:width="1dp"
                android:color="?attr/vibroOutlineColor" />
        </shape>
    </item>
</ripple>
